<Window x:Class="VectorLab.Views.LabelInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label Name"
        Height="170"
        Width="300"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="라벨 이름 입력"
                   Margin="0,0,0,10"
                   FontWeight="Bold" />
        <Grid>
            <TextBox x:Name="LabelNameTextBox"
                     Height="25"
                     VerticalAlignment="Center"
                     TextChanged="LabelNameTextBox_TextChanged"/>
            <TextBlock x:Name="PlaceholderText"
                       Text="Default"
                       Foreground="Gray"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
        
        <Button Content="OK"
                Width="60"
                HorizontalAlignment="Right"
                Click="OkButton_Click" 
                IsDefault="True"/>
    </StackPanel>
</Window>