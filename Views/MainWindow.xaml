<Window x:Class="VectorLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VectorLab"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0">
            <Button Content="Open GeoTIFF"
                    Command="{Binding OpenGeoTiffCommand}"
                    Padding="10,6"/>
        </StackPanel>

        <!-- 화단 : 좌(이미지/켄버스) + 우(라벨 리스트)-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 왼쪽: 이미지 + 오버레이 -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                <Grid x:Name="ImageContainer">
                    <!-- GeoTIFF 픽셀 표시 -->
                    <Image x:Name="Img"
                           Source="{Binding CurrentImage}"
                           Stretch="None"/>
                    <!-- 라벨 도형 레이어-->
                    <Canvas x:Name="Overlay"
                            Background="Transparent"
                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                            MouseMove="Overlay_MouseMove"
                            MouseLeftButtonUp="Overlay_MouseLeftButtonUp"/>
                </Grid>
            </ScrollViewer>
            
            <!-- 오른쪽: 라벨 리스트 -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="0">
                <DockPanel>
                    <TextBlock Text="Labels" FontWeight="Bold" Margin="8" DockPanel.Dock="Top"/>

                    <Button Content="삭제"
                            Margin="8,0,8,8"
                            Padding="8,4"
                            DockPanel.Dock="Top"
                            Click="DeleteSeletedButton_Click"/>

                    <ListBox ItemsSource="{Binding Labels}" 
                             SelectedItem="{Binding SelectedLabel, Mode=TwoWay}"
                             Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding ClassName}"/>
                                    <Run Text="  ("/>
                                    <Run Text="{Binding X, StringFormat=F0}"/>
                                    <Run Text=","/>
                                    <Run Text="{Binding Y, StringFormat=F0}"/>
                                    <Run Text=")  "/>
                                    <Run Text="{Binding Width, StringFormat=F0}"/>
                                    <Run Text=" x "/>
                                    <Run Text="{Binding Height, StringFormat=F0}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
